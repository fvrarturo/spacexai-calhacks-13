 "id": "dsi-morphology",
 "tab": "materials",
 "material": "cooling",
 "title": "Cell spacing measured in 54,000 ISS solidification images (DECLIC-DSI)",
 "question": "Can a physically meaningful, defensible morphology metric be extracted at scale from public ISS solidification imagery?",
 "headline": {
  "value": "53,895",
  "unit": "ISS frames",
  "text": "We measured cell spacing in 53,895 ISS images of a solidifying transparent alloy: runs settle at 223-731 um, and runs at the same pulling speed from different 2010 sequences differ 1.6x to 1.8x."
 },
